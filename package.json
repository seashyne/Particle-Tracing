{
  "name": "particle-tracing",
  "version": "1.0.0",
  "description": "High-performance forward photon transport, caustic simulation, and real-time streamline particle flow engine for WebGPU, Three.js, and browser graphics.",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "build:demo": "vite build demo --outDir dist --base ./",
    "dev": "vite demo",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "particle-tracing",
    "photon-mapping",
    "caustics",
    "ray-tracing",
    "light-transport",
    "threejs",
    "webgpu",
    "streamlines",
    "computer-graphics"
  ],
  "author": "Seashyne",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/seashyne/Particle-Tracing.git"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "three": "^0.186.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^4.1.10"
  }
}
